generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Admin {
  id       String @id @default(cuid())
  phone    String @unique
  password String
}

model Service {
  id              String  @id @default(cuid())
  title           String
  description     String
  image           String
  value           String
  order           Int     @default(0)
  // Optional "Saiba mais" modal detail fields (null = fall back to built-in copy)
  longDescription String?
  duration        String?
  idealFor        String?
  // Newline-separated lists (one item per line)
  features        String?
  includes        String?
}

model Video {
  id           String @id @default(cuid())
  title        String
  instagramUrl String
  order        Int    @default(0)
}

model Review {
  id     String  @id @default(cuid())
  name   String
  rating Int
  text   String
  order  Int     @default(0)
}

model Faq {
  id       String @id @default(cuid())
  question String
  answer   String
  order    Int    @default(0)
}

model LoginAttempt {
  id        String   @id @default(cuid())
  ip        String
  phone     String
  createdAt DateTime @default(now())

  @@index([ip, createdAt])
  @@index([phone, createdAt])
}

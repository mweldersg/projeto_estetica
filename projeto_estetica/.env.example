# PostgreSQL connection (main development database)
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# Optional: separate database for Playwright E2E tests (recommended).
# If not set, E2E runs against DATABASE_URL and reseeds it.
TEST_DATABASE_URL=""

# JWT secret for admin session tokens — REQUIRED, at least 32 bytes (64 hex chars)
# Generate with: openssl rand -hex 32
JWT_SECRET="change-me-to-at-least-64-hex-chars-aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"

# Initial admin is created via: npm run setup-admin (interactive, never via env or seed)

# Business WhatsApp number for booking deep links (country code + number, digits only)
NEXT_PUBLIC_WHATSAPP_NUMBER="5519998740950"

# Instagram profile link for the Instagram section
NEXT_PUBLIC_INSTAGRAM_URL="https://instagram.com/garage765"

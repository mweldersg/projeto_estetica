# PostgreSQL connection (main development database)
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# Optional: separate database for Playwright E2E tests (recommended).
# If not set, E2E runs against DATABASE_URL and reseeds it.
TEST_DATABASE_URL=""

# Admin credentials (used by the seed script and login route)
ADMIN_PHONE="19998740950"
ADMIN_PASSWORD="password"

# JWT secret for admin session tokens
JWT_SECRET="garage765-secret-key-2024"

# Business WhatsApp number for booking deep links (country code + number, digits only)
NEXT_PUBLIC_WHATSAPP_NUMBER="5519998740950"

# Instagram profile link for the Instagram section
NEXT_PUBLIC_INSTAGRAM_URL="https://instagram.com/garage765"

# Google Drive media uploads.
# Preferred: OAuth2 with your own Google account (owns the files, works with any Gmail).
# 1. Create an OAuth Client ID (Web application) in Google Cloud Console and add http://localhost:3001 as a redirect URI.
# 2. Run `npm run drive:auth`, authorize in the browser, and paste the resulting token below.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REFRESH_TOKEN=""

# Alternative: Google Workspace service account (only works for Workspace accounts;
# plain Gmail/consumer accounts reject service account uploads with "no storage quota").
# The private key must stay between double quotes, keeping the \n escapes
# GOOGLE_CLIENT_EMAIL="garage-storage-bot@project.iam.gserviceaccount.com"
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Target folder for uploaded media (must exist; files are made public per upload)
GOOGLE_DRIVE_FOLDER_ID=""
